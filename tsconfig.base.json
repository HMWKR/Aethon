{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "baseUrl": ".",
    "paths": {
      "@aethon/ai": ["packages/ai/src/index.ts"],
      "@aethon/core": ["packages/core/src/index.ts"],
      "@aethon/ui": ["packages/ui/src/index.ts"]
    }
  }
}
