# AETHON 환경 변수 예시 (키 이름만 — 값은 절대 넣지 말 것)
#
# 실제 값은 apps/web/.env.local 에만 저장한다. .env.local 은 .gitignore 로 차단되며
# 이 .env.example 파일만 커밋 대상이다. 클론 후 이 파일을 복사해 값을 채운다.

# Supabase — 프로젝트/캐릭터/씬 저장 + Storage + 인증 세션
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# NVIDIA NIM — DeepSeek V4 Pro AI 어드바이저(씬 구성/프롬프트 후보/모델 추천)
NVIDIA_NIM_API_KEY=

# SiliconFlow — Wan2.2 영상 생성 (가입 시 $1 무료 크레딧 ≈ 3회, $0.29/video)
SILICONFLOW_API_KEY=
