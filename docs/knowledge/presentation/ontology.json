  "production_workflow": [
    {
      "step": 1,
      "action": "목적·청중·형식과 공개 범위를 확인한다.",
      "needs": [
        "PPT-UNKNOWN-001",
        "PPT-UNKNOWN-002",
        "PPT-UNKNOWN-005"
      ]
    },
    {
      "step": 2,
      "action": "청중에 맞춰 슬라이드 후보와 핵심 메시지를 선택한다.",
      "uses": [
        "PPT-PURPOSE-001",
        "PPT-AUDIENCE-001"
      ]
    },
    {
      "step": 3,
      "action": "각 주장의 상태와 원문 근거, 사업 온톨로지의 관련 항목을 확인한다.",
      "uses": [
        "PPT-REVIEW-001"
      ]
    },
    {
      "step": 4,
      "action": "확인된 사실과 가설을 구분해 시각화를 만들고, 미확인 수치는 채우지 않는다.",
      "needs": [
        "PPT-UNKNOWN-003",
        "PPT-UNKNOWN-004"
      ]
    },
    {
      "step": 5,
      "action": "슬라이드별 출처와 버전을 기록하고 디자인·접근성과 발표 목적의 적합성을 검토한다.",
      "uses": [
        "PPT-REVIEW-002"
      ]
    },
    {
      "step": 6,
      "action": "근거가 바뀌면 영향을 받는 슬라이드를 다시 확인하고 실제 PPT 산출물을 갱신한다.",
      "uses": [
        "PPT-REVIEW-001"
      ]
    }
  ]
}
